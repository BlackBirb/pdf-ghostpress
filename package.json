{
  "name": "pdf-ghostpress",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "prod": "docker build --build-arg PORT=3000 -t blackbird/ghostscript:0.1.0 -t blackbird/ghostscript:latest ./",
    "gen:keys": "openssl genrsa -out certs/private.key 2048 && openssl rsa -in certs/private.key -outform PEM -pubout -out certs/public.key",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.7.1",
  "devDependencies": {
    "@types/node": "^25.2.0",
    "fast-jwt": "^6.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "fastify": "^5.7.2"
  }
}
